# Experimental native Rust API; does not replace the Python production image.
FROM rust:1-bookworm AS builder
WORKDIR /build
COPY . .
RUN cargo build --locked --release -p matchlab-server

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 --create-home app \
    && mkdir -p /data && chown app:app /data
COPY --from=builder /build/target/release/matchlab-server /usr/local/bin/matchlab-server
USER app
ENV MATCHLAB_DB=/data/metadata.sqlite3 MATCHLAB_HOST=0.0.0.0:8766
VOLUME ["/data"]
EXPOSE 8766
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["/usr/local/bin/matchlab-server", "--healthcheck"]
ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
CMD ["/usr/local/bin/matchlab-server"]
